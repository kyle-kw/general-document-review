# LLM_BASE_URL is the API base, usually ending in /v1, not /responses.
LLM_BASE_URL=http://your-internal-llm:8000/v1
LLM_API_KEY=replace-with-internal-key
LLM_MODEL=replace-with-model-name
LLM_TIMEOUT=300
LLM_CONTEXT_CHARS=48000
LLM_MAX_RETRIES=2
AGENT_CONCURRENCY=2

# Linux worker only; bubblewrap and rg are bundled in the worker image.
SANDBOX_COMMAND_TIMEOUT=60
SANDBOX_OUTPUT_BYTES=1048576
SANDBOX_MEMORY_MB=512
SANDBOX_PIDS_LIMIT=64
SANDBOX_FILE_MB=128
SANDBOX_WORKSPACE_MB=256
# OfficeCLI/.NET virtual address space; Compose still caps actual worker RAM at 2 GiB.
SANDBOX_OFFICECLI_AS_MB=4096
# Local Linux override only; Compose uses /usr/bin/bwrap.
# SANDBOX_BWRAP_PATH=/usr/bin/bwrap

# Empty disables OCR. Set a service base URL or the complete /layout-parsing URL.
PADDLEOCR_URL=
PADDLEOCR_TOKEN=
PADDLEOCR_BATCH_PAGES=10
PADDLEOCR_TIMEOUT=180

# Compose uses redis://redis:6379/0 by default; local development uses localhost.
REDIS_URL=redis://redis:6379/0
RQ_QUEUE=general-document-review
RQ_JOB_TIMEOUT=14400
RQ_RESULT_TTL=3600
RQ_FAILURE_TTL=86400
APP_PORT=8000
MAX_FILES=20
MAX_FILE_MB=100
MAX_UNPACKED_MB=1024
RETENTION_DAYS=30
# Use true behind HTTPS. LAN HTTP requires false.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Optional for local development; Compose always shares /app/data.
# DATA_DIR=data
# STATIC_DIR=frontend/dist
